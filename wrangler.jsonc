{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aimetadateremover",
  "account_id": "7fd7ed1128ca3d125feaa279f4d4c547",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AUTH_BASE_URL": "https://aimetadataremover.pro"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "aimetadateremover-auth",
      "database_id": "25630523-1dae-4032-b45b-f539622320f2",
      // Preserve the isolated local database; development never connects remotely.
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
