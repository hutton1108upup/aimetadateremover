{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aimetadateremover-feedback-delivery",
  "main": "workers/feedback-delivery.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [{
    "binding": "AUTH_DB",
    "database_name": "aimetadateremover-auth",
    "database_id": "25630523-1dae-4032-b45b-f539622320f2",
    "preview_database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations",
    "remote": false
  }],
  "observability": { "enabled": true }
}
